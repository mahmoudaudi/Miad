# =============================================================================
# event-invitation-platform — environment template
# Copy to .env (root) and to each app's .env as needed:
#   cp .env.example .env
# NEVER commit real secrets. NEVER expose backend secrets to the frontend.
# Only NEXT_PUBLIC_* variables are exposed to the browser.
# =============================================================================

# --- Database (PostgreSQL + Prisma) ---
# Used by: apps/api (NestJS) + prisma/
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/event_invitation?schema=public"
# Supabase pooler URLs need pooling flags, e.g.:
# DATABASE_URL="postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1"

# --- Backend (NestJS API) ---
# Used by: apps/api
PORT=3001
API_PREFIX=api
# Comma-separated list of allowed origins for CORS (dev default allows Next.js)
CORS_ORIGINS="http://localhost:3000"
JWT_SECRET="change-me-in-real-env-min-32-chars"
JWT_ACCESS_SECRET="generate-with-openssl-rand-hex-32-min-32-chars"
JWT_REFRESH_SECRET="generate-with-openssl-rand-hex-32-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
NODE_ENV="development"

# --- Frontend (Next.js) ---
# Used by: apps/web
# Must point at the versioned backend API, e.g. http://localhost:3001/api/v1
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# --- Supabase Storage (server-only; invitation media uploads) ---
# Used by: apps/api only. NEVER expose the service-role key to the browser
# and NEVER prefix it with NEXT_PUBLIC_.
SUPABASE_URL="https://REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# --- AI Provider (server-only) ---
# Used by: apps/api. Never expose provider keys to the browser.
AI_SERVICE_PORT=8000
AI_SERVICE_URL="http://localhost:8000"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="deepseek/deepseek-v4.1-flash"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_EXTRACTION_TIMEOUT_MS=20000
AI_PROVIDER_TIMEOUT_MS=20000

# Optional Google OAuth (server-only)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/v1/auth/google/callback"
FRONTEND_URL="http://localhost:3000"

# Password reset delivery (server-only; webhook receives the reset URL)
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_URL="http://localhost:3000/reset-password"
PASSWORD_RESET_WEBHOOK_URL=""
