{
  "name": "event-invitation-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Event Invitation Website Platform — monorepo foundation (setup phase only, no product features yet).",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared",
    "packages/config"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:ai": "uvicorn app.main:app --reload --port 8000 --app-dir apps/ai-service",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:ai": "pytest apps/ai-service/tests -v",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=./prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema=./prisma/schema.prisma",
    "db:seed": "prisma db seed"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
