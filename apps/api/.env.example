# Backend env template — copy to .env (never commit real values)
PORT=3001
API_PREFIX=api
CORS_ORIGINS="http://localhost:3000"
JWT_SECRET="change-me-in-real-env-min-32-chars"
JWT_ACCESS_SECRET="generate-with-openssl-rand-hex-32-min-32-chars"
JWT_REFRESH_SECRET="generate-with-openssl-rand-hex-32-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
NODE_ENV="development"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/event_invitation?schema=public"
# Supabase Storage (server-only, Feature 9 media). Never NEXT_PUBLIC_*.
SUPABASE_URL="https://REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
AI_SERVICE_URL="http://localhost:8000"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="deepseek/deepseek-v4.1-flash"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_EXTRACTION_TIMEOUT_MS=20000
AI_PROVIDER_TIMEOUT_MS=20000
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/v1/auth/google/callback"
FRONTEND_URL="http://localhost:3000"
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_URL="http://localhost:3000/reset-password"
PASSWORD_RESET_WEBHOOK_URL=""
